# Server
PORT=3000
# Comma-separated browser origins. Native mobile clients send no Origin and are allowed.
# Required for web clients in production. Example: https://app.example.com
# CORS_ORIGINS=

# Clerk (server-side only — never commit real values)
CLERK_SECRET_KEY=sk_test_your-secret-key-here

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, etc.)
# Prefer STORAGE_PROVIDER=s3|r2 in production. Falls back to local if unset.
STORAGE_PROVIDER=s3
S3_BUCKET=your-bucket
S3_REGION=auto
S3_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_FORCE_PATH_STYLE=true

# Local filesystem fallback (dev/tests only)
STORAGE_ROOT=./storage

# AI chat / Ask. Default is Gemini. Drop 4–5 Google AI Studio keys in the pool below.
# Document analysis, OCR, and transcription use AI_INGEST_MODEL (Flash-Lite)
# so uploads do not spend the Ask quota.
# OpenAI fallback: AI_PROVIDER=openai  AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini
AI_PROVIDER=gemini
AI_API_KEY=
# Optional extra Gemini keys — on 429 the provider rotates to the next free key.
# AI_API_KEY_1=
# AI_API_KEY_2=
# AI_API_KEY_3=
# AI_API_KEY_4=
# Or a single comma-separated list (also merges with AI_API_KEY / AI_API_KEY_N):
# AI_API_KEYS=AIza...,AIza...,AIza...
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_MODEL=gemini-3.8-flash
# Ingest model for analysis, OCR, and transcription. Defaults to gemini-3.5-flash-lite.
# AI_INGEST_MODEL=gemini-3.5-flash-lite
# Optional extra Flash ids to try before the built-in 3.6 / 3.5 / 3.5-lite chain
# when the primary model returns 503 (high demand) or 404.
# AI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash
# Voice capture uses AI_INGEST_MODEL unless you override it.
# TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
# Max in-flight chat/completions. Default = number of configured AI keys (max 8).
# With 4 keys, unset this (or set 4) to process ~4 documents / Ask calls in parallel.
# AI_CHAT_CONCURRENCY=4
# Retries after the first attempt (default 4 → 5 total). Retries re-queue on the gate.
# AI_CHAT_MAX_RETRIES=4

# Embeddings (required for text chunks before COMPLETED). Default is Gemini.
# Leave EMBEDDING_API_KEY* empty to reuse the chat Gemini pool (AI_API_KEY*).
# Dedicated embedding keys, if set, take precedence over the chat pool.
# OpenAI fallback: EMBEDDING_PROVIDER=openai  EMBEDDING_BASE_URL=https://api.openai.com/v1  EMBEDDING_MODEL=text-embedding-3-small
# local: deterministic vectors for plumbing tests only
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
# EMBEDDING_API_KEY_1=
# EMBEDDING_API_KEY_2=
# EMBEDDING_API_KEY_3=
# EMBEDDING_API_KEY_4=
# EMBEDDING_API_KEYS=AIza...,AIza...
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3

# Image OCR (Gemini multimodal). Falls back to EMBEDDING_API_KEY* then AI_API_KEY*.
# OCR_PROVIDER=none disables OCR (metadata-only images).
OCR_PROVIDER=gemini
OCR_API_KEY=
OCR_BASE_URL=https://generativelanguage.googleapis.com
OCR_MODEL=gemini-3.8-flash

# Semantic search
SEARCH_MIN_SIMILARITY=0.2
SEARCH_MAX_PER_OBSERVATION=2

# Ask Kairos (RAG)
ASK_MAX_CHUNKS=6
ASK_MAX_CONTEXT_CHARS=8000
ASK_HISTORY_MAX_MESSAGES=8
ASK_HISTORY_MAX_CHARS=4000

# Recall (Android screen memory — derived text only; no raw screenshots)
RECALL_ENABLED=true
# Dev-only. Production refuses to boot if this is true.
RECALL_STUB_GRANT_ALL=false

# RevenueCat webhook Authorization header value (server-only)
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer your_random_secret
# RevenueCat secret API key (server-only). Used to read App Store, Play, and Stripe
# subscriptions and save isPro on the Neon entitlement row.
REVENUECAT_SECRET_API_KEY=sk_your_secret_key



# RevenueCat Web Purchase Link (https://pay.rev.cat/...). Stripe checkout when
# Google Play and the App Store are not the vendor. Sandbox URL for development.
# REVENUECAT_STRIPE_PURCHASE_URL=https://pay.rev.cat/your-link
# Or set a default status when no DB row exists: inactive|trial|active|grace|expired|revoked
# RECALL_STUB_DEFAULT_STATUS=inactive
