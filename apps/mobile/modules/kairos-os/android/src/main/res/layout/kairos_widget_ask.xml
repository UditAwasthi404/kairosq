<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/kairos_ask_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="16dp"
  android:paddingEnd="12dp"
  android:background="@drawable/kairos_widget_bg">

  <ImageView
    android:layout_width="8dp"
    android:layout_height="8dp"
    android:contentDescription="@null"
    android:src="@drawable/kairos_widget_mark" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:letterSpacing="0.14"
      android:text="ASK KAIROS"
      android:textColor="#8A8A8A"
      android:textSize="10sp" />

    <TextView
      android:id="@+id/kairos_ask_insight"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="What did I save?"
      android:textColor="#F0F0F0"
      android:textSize="15sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/kairos_ask_button"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:layout_marginStart="10dp"
    android:background="@drawable/kairos_widget_btn_ask"
    android:gravity="center"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:text="Ask"
    android:textColor="#FFFFFF"
    android:textSize="13sp" />
</LinearLayout>
