<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/kairos_capture_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="14dp"
  android:background="@drawable/kairos_widget_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:contentDescription="@null"
      android:src="@drawable/kairos_widget_mark" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:letterSpacing="0.16"
      android:text="KAIROS"
      android:textColor="#8A8A8A"
      android:textSize="11sp" />
  </LinearLayout>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:maxLines="2"
    android:text="Keep a thought"
    android:textColor="#F0F0F0"
    android:textSize="18sp" />

  <TextView
    android:id="@+id/kairos_capture_main"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:background="@drawable/kairos_widget_btn_ask"
    android:gravity="center"
    android:text="Capture"
    android:textColor="#FFFFFF"
    android:textSize="14sp" />

  <TextView
    android:id="@+id/kairos_capture_voice"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/kairos_widget_btn"
    android:gravity="center"
    android:text="Voice"
    android:textColor="#F0F0F0"
    android:textSize="13sp" />
</LinearLayout>
