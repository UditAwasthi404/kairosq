# Clerk (public — safe to expose in the client bundle)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Kairos API base URL used by the mobile client
EXPO_PUBLIC_API_URL=http://localhost:3000

# RevenueCat public SDK keys (platform-specific; never use secret API keys here)
# Used by iOS and Android development builds with RevenueCat Test Store.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
# Retained for store-backed release builds.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_ios_sdk_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_android_sdk_key
